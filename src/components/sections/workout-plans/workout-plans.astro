---
import { InteractiveHoverButton } from "@/components/ui/interactive-hover-button"
import { WORKOUT_PLANS } from "@/lib/constants"
import WorkoutCard from "@/components/sections/workout-plans/workout-card.astro"
import { BlurFade } from "@/components/ui/blur-fade"
---

<section class="py-16 sm:py-20 lg:py-24" id="workout-plans">
  <div class="wrapper">
    <div
      class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-6"
    >
      <div>
        <span class="section-eyebrow">ТРЕНИРОВОЧНЫЕ ПРОГРАММЫ</span>

        <h2 class="section-title">ВЫБЕРИТЕ СВОЙ ПУТЬ.</h2>
      </div>

      <InteractiveHoverButton>ВСЕ ПРОГРАММЫ</InteractiveHoverButton>
    </div>

    <div
      class="mt-8 grid grid-cols-1 items-stretch gap-4 sm:mt-10 sm:grid-cols-2 md:gap-5 lg:mt-12 lg:grid-cols-4 lg:gap-4"
    >
      {
        WORKOUT_PLANS.map((plan, idx) => (
          <BlurFade inView delay={0.25 * idx * 0.5} client:load>
            <WorkoutCard {...plan} idx={idx + 1} />
          </BlurFade>
        ))
      }
    </div>
  </div>
</section>
