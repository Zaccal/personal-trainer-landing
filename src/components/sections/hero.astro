---
import { Button } from "@/components/ui/button"
import { RainbowButton } from "@/components/ui/rainbow-button"
import { Image } from "astro:assets"
import heroMain from "@/assets/hero-main.webp"
import DashedGridLayout from "@/layouts/dashed-grid-layout.astro"
---

<section>
  <DashedGridLayout>
    <div
      class="wrapper flex flex-col items-center pt-24 1080:flex-row 1080:items-center"
    >
      <div class="hero-content">
        <span class="hero-eyebrow">
          ПЕРСОНАЛЬНЫЙ ТРЕНИНГ • РЕАЛЬНЫЙ РЕЗУЛЬТАТ
        </span>

        <h1 class="hero-title">
          <span>ТРАНСФОРМИРУЙ</span> СВОЁ ТЕЛО. <span>РАСКРОЙ</span> СВОЙ <span
            >ПОТЕНЦИАЛ</span
          >.
        </h1>

        <p class="hero-description">
          Персональные тренировки и индивидуальный подход, которые помогут тебе
          стать сильнее, увереннее и достичь своих целей.
        </p>

        <div class="hero-actions">
          <RainbowButton size="responsive" className="font-bold">
            ЗАПИСАТЬСЯ НА КОНСУЛЬТАЦИЮ
          </RainbowButton>

          <Button variant="outline" className="font-bold" size="responsive">
            СМОТРЕТЬ ПРОГРАММЫ
          </Button>
        </div>
      </div>

      <div class="hero-image">
        <Image
          loading="eager"
          src={heroMain}
          format="webp"
          quality={80}
          width={1222}
          height={1402}
          class="size-full object-contain"
          fetchpriority="high"
          alt="gym-man"
        />
      </div>
    </div>
  </DashedGridLayout>
</section>
