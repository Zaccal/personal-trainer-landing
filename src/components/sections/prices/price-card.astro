---
export type Variant = "default" | "popular"

export interface Props {
  className?: string
  variant?: Variant
  planName: string
  description: string
  price: number
  billingCycle: string
  features: readonly string[]
  buttonText: string
  isCurrentPlan?: boolean
  href?: string
}

const {
  className = "",
  variant = "default",
  planName,
  description,
  price,
  billingCycle,
  features,
  buttonText,
  isCurrentPlan = false,
  href = "#",
} = Astro.props

const cardClasses = [
  "pricing-card",
  "relative flex flex-col p-8 rounded-2xl border shadow-sm transition-all duration-300",
  "hover:scale-[1.02]",
  variant === "popular"
    ? "bg-card border-primary shadow-lg shadow-primary/10 -translate-y-2"
    : "bg-card border-border",
  className,
]
  .filter(Boolean)
  .join(" ")

const buttonClasses = [
  "inline-flex items-center justify-center rounded-md text-sm font-medium",
  "transition-colors focus-visible:outline-none focus-visible:ring-2",
  "focus-visible:ring-ring focus-visible:ring-offset-2",
  "h-11 px-8 w-full",
  isCurrentPlan
    ? "bg-secondary text-secondary-foreground opacity-50 cursor-not-allowed"
    : variant === "popular"
      ? "bg-primary text-primary-foreground hover:bg-primary/90"
      : "border border-input bg-background hover:border-primary hover:bg-primary hover:text-primary-foreground",
]
  .filter(Boolean)
  .join(" ")
---

<div class={cardClasses}>
  {
    variant === "popular" && (
      <div class="absolute top-0 right-8 -translate-y-1/2 rounded-full bg-primary px-4 py-1.5 text-xs font-semibold text-primary-foreground">
        ПОПУЛЯРНЫЙ
      </div>
    )
  }

  <div class="mb-4 flex items-center gap-4">
    <slot name="icon" />

    <div>
      <h3 class="text-xl font-bold text-card-foreground">
        {planName}
      </h3>

      <p class="text-sm text-muted-foreground">
        {description}
      </p>
    </div>
  </div>

  <div class="my-6">
    <span class="text-4xl font-bold md:text-5xl">
      {price.toLocaleString("ru-RU")} ₸
    </span>
    <span class="text-muted-foreground">{billingCycle}</span>
  </div>

  {
    isCurrentPlan ? (
      <button class={buttonClasses} disabled>
        Current plan
      </button>
    ) : (
      <a href={href} class={buttonClasses}>
        {buttonText}
      </a>
    )
  }

  <ul class="mt-8 flex-1 space-y-4 text-sm text-muted-foreground">
    {
      features.map((feature) => (
        <li class="flex items-start gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="mt-0.5 h-5 w-5 shrink-0 text-primary"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z"
              clip-rule="evenodd"
            />
          </svg>

          <span>{feature}</span>
        </li>
      ))
    }
  </ul>
</div>
